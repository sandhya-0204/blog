        .sprinix-blog-wrapper-module .row {
            grid-template-columns: <?= !empty($isRecentPostsVisible) && $isRecentPostsVisible ? '1fr' : '1fr' ?>;
        <?= !empty($isRecentPostsVisible) && $isRecentPostsVisible ? null : 'justify-content: center;'?>
        }
    }
</style>

<script type="text/x-magento-init">
    {
        "#comment-form": {
            "validation": {}
        },
        "#reply-form": {
            "validation": {}
        }
    }
</script>

<script type="text/javascript">
    require(['jquery', 'mage/validation'], function ($) {
        $(document).ready(function () {
            $(document).on('click', '.reply-btn', function (e) {
                e.preventDefault();
                $("#reply-form-container").remove();
                const target = $(this).data('target');
                const form = $("#comment-reply-form")[0].innerHTML;
                $(`<div id="reply-form-container">${form}<div>`).insertAfter($(this).parent());
                $('#reply-form-container #reply-form').validation();
                $("#reply-form-container h2").text();
                $('<input>', {
                    type: 'hidden',
                    name: 'replied_to',
                    value: target.split('-').at(-1)
                }).prependTo("#reply-form");
            });
            $(document).on('click', '.cancel', function () {
                if($("#reply-form-container").length) {
                    $("#reply-form-container").remove();
                }
            })
        });
    });
</script>
