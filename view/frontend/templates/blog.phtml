                                    <?php endif; ?>
                                <?php endforeach; ?>
                            <?php endif; ?>
                            <div class="reply-btns">
                                <a class="reply-btn" href="#" data-target="reply-form-<?= $comment->getCommentId() ?>">Reply</a>
                                <p><span><?= $count; ?></span>Reply</p>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
                <div id="comment-reply-form" style="display: none">
                    <h3>Reply</h3>
                    <form id="reply-form" action="<?= $this->getReplyFormAction() ?>"
                          data-mage-init='{"validation": {}}'
                          method="post">
                        <input type="hidden" name="post_id" value="<?= !empty($post) ? $post->getPostId() : null ?>" />
                        <div class="input-group">
                            <input type="text" name="reply_name" placeholder="Name" data-validate="{required:true}" />
                            <input type="email" name="reply_email" placeholder="Email" data-validate="{required:true, 'validate-email':true}" />
                            <textarea name="reply" rows="4" placeholder="Comment" data-validate="{required:true}"></textarea>
                            <div>
                                <button class="blog-comment-btn" type="submit">Post Reply</button>
                                <button type="button" class="cancel">Cancel</button>
