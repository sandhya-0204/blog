                                            <div class="recent-post-content">
                                            <div class="post-details">
                                                <div class="post-author">
                                                    <img src="https://cdn.pixabay.com/photo/2021/07/25/08/03/account-6491185_1280.png"
                                                         alt="image"/>
                                                    <p class="author-name"><?= $recentPost->getAuthor() ?></p>
                                                </div>
                                                <p class="post-created-date"><?= __($helper->getFormattedDate($recentPost->getCreatedAt())) ?></p>
                                            </div>
                                            <a class="recent-post-title"
                                               href="<?= $block->getBaseUrl() . 'blog/' . $recentPost->getUrlKey() ?>">
                                                <?= $recentPost->getTitle() ?>
                                            </a>
                                            </div>
