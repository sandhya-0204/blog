                                            <div class="comment-user-info">
                                                <img class="user-photo"
                                                     src="https://cdn.pixabay.com/photo/2021/07/25/08/03/account-6491185_1280.png"/>
                                                <span class="user-name"><?= __($message->getReplyName()) ?></span>
                                                <span class="comment-created_at"><?= $helper->getTimeDiff($message->getCreatedAt()) ?></span>
                                            </div>
                                            <p class="comment-text"><?= __($message->getReply()) ?></p>
