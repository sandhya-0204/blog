$comments = [];
$repliedMessages = [];
$recentPosts = [];
$post = $block->getPost();
if(!empty($block->getRecentPost())) {
    $recentPosts = $block->getRecentPost()->getItems();
}
if (!empty($post)) {
    $comments = $block->getCommentbyPostId($post->getPostId());
    $repliedMessages = $block->getAllCommentsReply($post->getPostId());
}
$helper = $this->helper('Sprinix\Blogs\Helper\CustomDateTime');
$layoutHelper = $this->helper('Sprinix\Blogs\Helper\Data');
$categoryStatusChecker = $this->helper('Sprinix\Blogs\Helper\CategoryStatusChecker');
