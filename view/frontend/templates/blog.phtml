                    <div class="post-details">
                        <div class="post-author">
                            <img src="https://cdn.pixabay.com/photo/2021/07/25/08/03/account-6491185_1280.png"
                                 alt="image"/>
                            <p class="author-name"><?= $post->getAuthor() ?></p>
                        </div>
                        <p class="post-created-date"><?= __($helper->getFormattedDate($post->getCreatedAt())) ?></p>
                    </div>
                    <a class="post-title" href="<?= $block->getBaseUrl() . 'blog/' . $post->getUrlKey() ?>">
                        <?= $post->getTitle() ?>
                    </a>
                    <p class="post-summary"><?php echo $post->getContent() ? html_entity_decode($post->getContent()) : null ?></p>
                </div>
            </div>
