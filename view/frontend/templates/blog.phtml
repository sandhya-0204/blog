    <div class="row">
        <?php if (!empty($post)): ?>
            <div class="post-card box post-card-box-wrap">
                <div class="post-card-main-image">
                    <a href="<?= $block->getBaseUrl() . 'blog/' . $post->getUrlKey() ?>">
