                          data-mage-init='{"validation": {}}' method="post">
                        <input type="hidden" name="commented_on" value="<?= !empty($post) ? $post->getPostId() : null ?>" />
                        <div class="input-group">

                            <input type="text" name="comment_name" placeholder="Name" data-validate="{required:true}"/>

                            <input type="email" name="comment_email" placeholder="Email"
                                   data-validate="{required:true, 'validate-email':true}"/>
                            <textarea rows="4" name="comment" placeholder="Comment" data-validate="{required:true}"></textarea>
                            <button class="blog-comment-btn" type="submit">Post Comment</button>
